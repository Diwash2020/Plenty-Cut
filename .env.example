# ---- Plentycut settings. Copy this file to .env and fill it in. Never commit .env. ----
#
# On your own computer you need nothing here: start Plentycut, open it, and add your AI key under Settings, AI.
# This file is for servers, and for anyone who prefers to keep settings in a file.

# ================================================================ AI: bring your own key
# The easy way is the dashboard: Settings, AI. Whatever is saved there is used instead of these lines.
# Plentycut uses an AI model to pick the moments worth clipping and to write hooks, titles and captions.
# You choose the service and pay that service directly; Plentycut adds nothing on top.
# Without a key Plentycut still works: clips are then picked by loudness only, with no titles.
#
#   provider     where to get a key                          example model ids (check the provider's current list)
#   gemini       https://aistudio.google.com/apikey           gemini-2.5-flash
#   openai       https://platform.openai.com/api-keys         gpt-4o-mini
#   xai          https://console.x.ai                         grok-4            (Grok)
#   groq         https://console.groq.com/keys                llama-3.3-70b-versatile
#   openrouter   https://openrouter.ai/keys                   any model id listed there
#   anthropic    https://console.anthropic.com                a current Claude model id
#   ollama       no key: a model running on this machine      llama3.1          (ollama pull llama3.1)
#   custom       any service that speaks the OpenAI chat format: also set PLENTYCUT_AI_BASE_URL
PLENTYCUT_AI_PROVIDER=gemini
PLENTYCUT_AI_MODELS=
PLENTYCUT_AI_KEY=
# PLENTYCUT_AI_KEY_FILE=/secrets/ai.txt        # instead of PLENTYCUT_AI_KEY: a file that holds the key
# PLENTYCUT_AI_BASE_URL=                       # only for "custom", e.g. http://127.0.0.1:1234/v1
# PLENTYCUT_AI_MODELS takes several ids separated by commas. They are tried in order, so the second is a fallback.

# ================================================================ on a server (Docker): see DEPLOY.md
# Your domain (DNS must already point at this server) and a database password you make up.
# PLENTYCUT_DOMAIN=plentycut.example.com
# POSTGRES_PASSWORD=change-me-to-a-long-random-string

# A server Plentycut has to itself: keep this line, and Plentycut fetches its own HTTPS certificate.
# A server that already runs a web server for other sites: leave it out and see deploy/nginx-plentycut.conf.
# COMPOSE_PROFILES=own-https
# Behind Cloudflare's CDN: put the Cloudflare origin certificate in ./secrets as cloudflare-origin.crt and
# cloudflare-origin.key, and use the Caddyfile that serves it.
# PLENTYCUT_CADDYFILE=Caddyfile.origin
# PLENTYCUT_BIND_PORT=8765           # the port Plentycut listens on inside the server, if 8765 is taken
# Behind a Traefik that is already on the server, use this instead of the own-https line:
# COMPOSE_FILE=docker-compose.yml:deploy/docker-compose.traefik.yml
# If the domain goes through Cloudflare's CDN (orange cloud), the visitor's real address comes in this header.
# It is only believed for connections that really come from Cloudflare.
# PLENTYCUT_CLIENT_IP_HEADER=CF-Connecting-IP

# On a server shared with other apps: keep Plentycut inside its own share.
# PLENTYCUT_MEM_LIMIT=2g             # most memory it may use (it is stopped, not the other apps, if it goes over)
# PLENTYCUT_CPUS=1.5                 # most processor cores it may use
# PLENTYCUT_CPU_SHARES=256           # its turn at the processor when the server is busy (1024 is normal)
# PLENTYCUT_OOM_SCORE_ADJ=900        # if the whole server runs out of memory, Plentycut is stopped first
# PLENTYCUT_DB_MEM_LIMIT=256m

# ================================================================ where things are kept (own computer)
# PLENTYCUT_DATA=./data              # videos, clips, the database file and the speech model
# PLENTYCUT_PORT=8765
# PLENTYCUT_PUBLIC_URL=http://127.0.0.1:8765     # the address people open; set it to https://your-domain on a server
# DATABASE_URL=                    # empty: a SQLite file in the data folder. Or postgresql+psycopg://user:pass@host/db

# ================================================================ sign-in
# Off by default: Plentycut opens straight into the dashboard, which is right for your own computer.
# On a server other people can reach, turn accounts on, or anyone who finds the address can use it and your AI key.
# (docker-compose.yml turns them on by itself.)
# PLENTYCUT_ACCOUNTS=1

# ================================================================ admins (only with accounts on)
# Admins are not set here. Every new account is a normal user. After you sign up, make yourself an admin:
#   python -m studio.admin grant you@example.com                 (also: revoke, list)
#   docker compose exec app python -m studio.admin grant you@example.com      (with Docker)
# The admin dashboard is then at /admin, and does not exist for anyone else.

# ================================================================ Google (optional)
# One "Web application" OAuth client, used for Sign in with Google and for connecting YouTube to post Shorts.
# Authorised redirect URIs:  https://YOUR-DOMAIN/auth/google/callback  and  https://YOUR-DOMAIN/oauth/youtube/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CLIENT_FILE=/secrets/google_client.json

# ================================================================ email (optional)
# Any SMTP service. Without it, password-reset and confirmation links are printed in the server's output instead,
# which is enough on your own computer.
# PLENTYCUT_SMTP_HOST=
# PLENTYCUT_SMTP_PORT=587
# PLENTYCUT_SMTP_USER=
# PLENTYCUT_SMTP_PASSWORD=
# PLENTYCUT_SMTP_PASSWORD_FILE=/secrets/smtp.txt
# PLENTYCUT_MAIL_FROM=Plentycut <hello@your-domain.com>
# PLENTYCUT_VERIFY_EMAIL=1           # on a public site: people must confirm their email before clipping

# Shown on the privacy, terms and acceptable-use pages of a public site.
# PLENTYCUT_CONTACT_EMAIL=
# PLENTYCUT_LEGAL_NAME=
# PLENTYCUT_LEGAL_COUNTRY=

# ================================================================ limits (all optional)
# How many videos run at once is decided by how busy the machine really is, every second. These only set the edges:
# PLENTYCUT_JOB_WORKERS=8            # the most videos that may ever run at once (default: one per CPU core)
# PLENTYCUT_BUSY_CPU=82              # no extra video or recording starts while the processor is above this percent
# PLENTYCUT_MIN_FREE_RAM_GB=1.5      # ...or while less memory than this is free
# PLENTYCUT_MAX_LIVE=4               # live recordings at once, whole server
# PLENTYCUT_MAX_LIVE_PER_USER=1
# PLENTYCUT_MAX_JOBS_PER_USER=3
# PLENTYCUT_MAX_UPLOAD_MB=2048       # the largest video file someone may upload
# PLENTYCUT_UPLOAD_PART_MB=40        # big files are sent in pieces of this size (Cloudflare refuses requests over 100 MB)
# PLENTYCUT_MAX_VIDEO_HOURS=6        # longest video, or chosen part of one, that is processed
# PLENTYCUT_MAX_LIVE_HOURS=12        # a live recording stops by itself after this long
# PLENTYCUT_MAX_USER_GB=50           # disk space one account may use
# PLENTYCUT_ALLOWED_SITES=youtube.com,youtu.be,twitch.tv,kick.com
# PLENTYCUT_YT_TRANSCRIPT=1          # use YouTube's own transcript to find clips faster (0: always transcribe here)

# ================================================================ speech to text on a graphics card (optional)
# Speech is transcribed on this machine's processor by default. A second machine with an NVIDIA card can take
# over most of it: see deploy/gpu/docker-compose.yml, then set these on the main server.
# PLENTYCUT_ASR_URL=http://10.0.0.2:9000
# PLENTYCUT_ASR_TOKEN=a-long-random-string-shared-by-both-machines
